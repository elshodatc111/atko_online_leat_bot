# =====================================================================
#  ATKO Lead platforma — sozlamalar
#  Bu faylni ".env" nomi bilan nusxalang va qiymatlarni to'ldiring.
# =====================================================================

# --- Telegram bot (@BotFather dan olinadi) ---
BOT_TOKEN=1234567890:AAAA-bu-yerga-bot-tokenini-yozing

# Admin(lar)ning Telegram ID raqami (botga /myid yozib bilib olasiz).
# Bir nechta bo'lsa vergul bilan: 111111,222222
ADMIN_TG_IDS=123456789

# --- OpenAI ---
# Kalitni panel -> Sozlamalar bo'limida ham kiritish mumkin
OPENAI_API_KEY=sk-...

# --- Veb-panel ---
# Panel manzili (bildirishnomalardagi havolalar uchun)
PANEL_URL=http://localhost:8000
# Sessiya shifrlash kaliti — istalgan uzun tasodifiy matn yozing!
SECRET_KEY=bu-yerga-uzun-tasodifiy-matn-yozing-12345
HOST=127.0.0.1
PORT=8000

# --- Bot rejimi ---
# polling — lokal kompyuter uchun (standart)
# webhook — server uchun (alwaysdata). Bunda WEBHOOK_BASE_URL majburiy.
BOT_MODE=polling
WEBHOOK_BASE_URL=
# Webhook manzilini yashirish uchun tasodifiy matn (webhook rejimida majburiy)
WEBHOOK_SECRET=

# --- Qo'shimcha ---
TIMEZONE=Asia/Tashkent
# Ma'lumotlar papkasi (baza, fayllar). Bo'sh bo'lsa loyiha ichidagi "data" papkasi
DATA_DIR=
DEBUG=false
